<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press the icon. Each shortcut opens the app at a chapter: MainActivity
  reads the "go" extra and taps that chapter's tab once the page is ready.
  A "then" extra of "voice" starts listening once Write is open.
  Revisit is added at runtime instead (MainActivity.syncRevisitShortcut), so
  its label can carry the count waiting.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="write"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_write"
        android:shortcutShortLabel="@string/shortcut_write"
        android:shortcutLongLabel="@string/shortcut_write_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.noteworthy.android"
            android:targetClass="com.noteworthy.android.MainActivity">
            <extra android:name="go" android:value="capture" />
        </intent>
    </shortcut>
    <!-- Write, already listening: for walking, cooking, driving. -->
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.noteworthy.android"
            android:targetClass="com.noteworthy.android.MainActivity">
            <extra android:name="go" android:value="capture" />
            <extra android:name="then" android:value="voice" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="days"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_days"
        android:shortcutShortLabel="@string/shortcut_days"
        android:shortcutLongLabel="@string/shortcut_days_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.noteworthy.android"
            android:targetClass="com.noteworthy.android.MainActivity">
            <extra android:name="go" android:value="days" />
        </intent>
    </shortcut>
</shortcuts>
