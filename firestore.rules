rules_version = '2';

// ============================================================================
// Noteworthy — Firestore security rules
// ============================================================================
//
// Before these rules existed, the database answered anyone. This was a real,
// working request against the live project, from a machine that had never
// opened the app:
//
//   curl "https://firestore.googleapis.com/v1/projects/noteworthy-4994f\
//         /databases/(default)/documents/notes?key=<the public web api key>"
//
// It returned notes. HTTP 200. The web apiKey in firebase.js is an identifier
// that ships in every page — it was never the thing keeping anyone out, and
// the four-digit PIN in app.js is checked in the browser, so it never was
// either. This file is the only real boundary the notebook has.
//
// The check is an explicit uid allowlist rather than `request.auth != null`.
// Anyone can call the anonymous or sign-up endpoints with a public apiKey and
// come back holding a valid token, so "is signed in" would let the whole
// internet through wearing a badge. "Is one of these two accounts" does not.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The accounts, by Firebase Auth uid. Adding a device means signing in
    // as one of these; adding a person means adding their uid here and
    // publishing again.
    //
    // The ring is on this list too, not exempt from it. worker/ signs in as a
    // dedicated account and writes through these rules like any other client,
    // rather than holding a service account that would bypass them — so taking
    // the ring's access away is deleting a line here, the same as for a person.
    function isOwner() {
      return request.auth != null && request.auth.uid in [
        '1rpvaevBM7MAEbKpd57SzV5hf782',
        'Cu0McEi9mgXFPytKEzCOMh1SLCQ2',

        // ring@noteworthy.local — the Index 01 receiver in worker/.
        'p0jzCKVHGFelb8OOEEJiHZvee3B3'
      ];
    }

    // One rule for the whole notebook rather than ten near-identical ones.
    // The collections in play today are: notes, cards, chats, memory, concepts,
    // connections, clusters, syntheses, letters, days. A per-collection list would
    // mean the next collection someone adds is silently unreachable — or,
    // worse, that a copy-pasted block leaves it open. Everything here belongs
    // to the same two people, so it takes the same answer.
    match /{document=**} {
      allow read, write: if isOwner();
    }

    // People trying the app out. Unlike the owners they get one notebook each:
    // every document here carries a `profile`, and a tester can only touch the
    // ones that carry theirs — reading, creating, and on update both before and
    // after, so a note can't be handed across into someone else's notebook.
    //
    // Because rules are not filters, a tester's queries must say
    // where('profile', ...) themselves or Firestore refuses the whole query.
    // The client's map of these same uids is TESTER_PROFILES in api.js.
    function testerProfile() {
      return request.auth == null ? null : {
        'HARINI_UID': 'harini',
        '4iREzQonHDgQDjnvbTTUDxhJRIt2': 'kalpesh'
      }.get(request.auth.uid, null);
    }

    match /{collection}/{id} {
      // resource is null for a document that doesn't exist, and saying so
      // gives nothing away — while refusing would turn every read of a
      // since-deleted note into an error instead of a quiet "not found".
      allow read: if testerProfile() != null
        && (resource == null || resource.data.profile == testerProfile());
      allow delete: if testerProfile() != null
        && resource.data.profile == testerProfile();
      allow create: if testerProfile() != null
        && request.resource.data.profile == testerProfile();
      allow update: if testerProfile() != null
        && resource.data.profile == testerProfile()
        && request.resource.data.profile == testerProfile();
    }
  }
}
