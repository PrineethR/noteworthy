<?xml version="1.0" encoding="utf-8"?>
<!--
  The Write widget at two rows: the date and a greeting, as the app's home
  has them, over the same line and mic. Nothing else: no counts, no tiles.
  The whole card opens Write; the mic opens it listening. The line is sunk a
  shade, since on one paper with the card it would otherwise disappear, and
  so the mic's circle turns to paper to stand off it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_write_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="8dp"
    tools:targetApi="s">

    <!-- Lined up with the flower below: 8dp of card and 14dp of line. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_write_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/widget_write_secondary"
            android:textSize="11sp"
            tools:text="Saturday 24 October" />

        <TextView
            android:id="@+id/widget_write_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/widget_write_ink"
            android:textSize="22sp"
            tools:text="Good evening." />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_write_well"
        android:contentDescription="@string/widget_write_cd_write"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_write_flower" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_write_placeholder"
            android:textColor="@color/widget_write_placeholder"
            android:textSize="17sp"
            android:textStyle="italic" />

        <ImageButton
            android:id="@+id/widget_write_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_write_dot"
            android:backgroundTint="@color/widget_write_paper"
            android:contentDescription="@string/widget_write_cd_speak"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_write_mic" />
    </LinearLayout>
</LinearLayout>
